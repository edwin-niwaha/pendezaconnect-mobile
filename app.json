{
  "expo": {
    "name": "Pendeza Connect",
    "slug": "pendeza-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "pendezaconnect",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "org.pendeza.connect",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0f766e"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0f766e",
          "defaultChannel": "account-updates"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Pendeza Connect to select a phone number for Mobile Money donations."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Pendeza Connect to take child profile photos.",
          "photosPermission": "Allow Pendeza Connect to select child profile photos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1a425fd-57f0-46f7-9b0e-7b3754d8b21c"
      }
    },
    "owner": "perpetual-labs"
  }
}
