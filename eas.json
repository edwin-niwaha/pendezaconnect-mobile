        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "887994843584-ds1v3pom7ml5fe3gt6vncvt8stjn4i1v.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "887994843584-gep9350oqbd24t4gra62dbffua7fa032.apps.googleusercontent.com"
